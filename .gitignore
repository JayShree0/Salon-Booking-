# ==============================================================================
# SALON BOOKING APPLICATION - ROOT .GITIGNORE (FULL-STACK + AWS DEPLOYMENT)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS & SECURITY SECRETS (CRITICAL - NEVER COMMIT TO GITHUB)
# ------------------------------------------------------------------------------
# AWS credentials, profiles, and key pairs
.aws/
credentials
*.pem
*.ppk
*.key
*.cer
*.p12
*.pfx

# Environment variables & local configuration
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# Keep example template file for team & CI/CD reference
!.env.example

# Docker local overrides
docker-compose.override.yml

# Terraform & CloudFormation state/vars (if using IaC on AWS)
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform/
.aws-sam/
cdk.out/

# ------------------------------------------------------------------------------
# 2. JAVA / SPRING BOOT MICROSERVICES (MAVEN)
# ------------------------------------------------------------------------------
# Compiled class files & build directories
**/target/
target/
*.class

# Log files & local execution logs
*.log
**/.run-logs/
logs/

# Packaged binaries (build outputs are generated in CI/CD or on AWS)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven dependency cache (prevents committing downloaded third-party jars)
**/.maven/
.maven/

# Maven wrapper executable (jar should not be committed, scripts must be preserved)
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties
!mvnw
!mvnw.cmd

# JVM crash logs
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# 3. FRONTEND (REACT / VITE / NODE)
# ------------------------------------------------------------------------------
# Dependencies
**/node_modules/
node_modules/
jspm_packages/

# Production build outputs
**/dist/
dist/
**/dist-ssr/
dist-ssr/
**/.vite/
.vite/
build/
**/build/

# Test coverage & tool caches
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/
.eslintcache
.tsupgrader/
**/.tsupgrader/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Safeguard package manifests
!package.json
!package-lock.json

# ------------------------------------------------------------------------------
# 4. IDEs & TEXT EDITORS
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
**/.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# Visual Studio Code
.vscode/
**/.vscode/
!.vscode/extensions.json

# NetBeans
**/nbproject/private/
**/nbbuild/
**/nbdist/
/.nb-gradle/

# ------------------------------------------------------------------------------
# 5. OPERATING SYSTEM ARTIFACTS
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
